{
  "name": "@everyday-mcp-hebrew/csv-structure-checker",
  "version": "1.0.0",
  "description": "Deterministic local CSV structure validation without content disclosure",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": { "everyday-csv-structure-mcp": "dist/src/server.js" },
  "files": ["dist/src", "README.md", "metadata.json", "examples"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/server.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": { "@modelcontextprotocol/server": "2.0.0", "zod": "4.4.3" },
  "devDependencies": { "@modelcontextprotocol/client": "2.0.0", "@types/node": "20.19.43", "typescript": "7.0.2" }
}
