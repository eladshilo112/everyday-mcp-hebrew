{
  "name": "@everyday-mcp-hebrew/disk-space-analyzer",
  "version": "1.0.0",
  "description": "Deterministic local read-only MCP server for analyzing disk space",
  "type": "module",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "bin": {
    "everyday-disk-space-analyzer-mcp": "dist/src/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "metadata.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "start": "node dist/src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "hebrew",
    "files",
    "disk-space",
    "storage",
    "local-first",
    "read-only"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
