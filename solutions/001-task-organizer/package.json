{
  "name": "@everyday-mcp-hebrew/task-organizer",
  "version": "1.0.0",
  "description": "Deterministic local MCP task organizer for Hebrew and English",
  "type": "module",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "bin": {
    "everyday-dayplan": "dist/src/cli.js",
    "everyday-dayplan-mcp": "dist/src/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "metadata.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/parser.test.js dist/tests/scheduler.test.js dist/tests/determinism.test.js dist/tests/mcp-integration.test.js",
    "start": "node dist/src/server.js",
    "demo": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "hebrew",
    "tasks",
    "productivity",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
