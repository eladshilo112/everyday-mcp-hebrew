{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "repository",
    "owner_role",
    "status",
    "phase",
    "started_at_utc",
    "heartbeat_at_utc",
    "next_action",
    "blocked_reason",
    "artifacts"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "owner_role": { "type": "string", "const": "local_runner" },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "preflight_passed",
        "planning",
        "implementation",
        "validation",
        "review",
        "publishing",
        "published",
        "dry_run_passed",
        "duplicate_date_noop",
        "failed"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "initialized",
        "preflight",
        "planning",
        "implementation",
        "validation",
        "review",
        "publication",
        "completed",
        "failed"
      ]
    },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "heartbeat_at_utc": { "type": "string", "format": "date-time" },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 240 },
    "blocked_reason": { "type": ["string", "null"], "maxLength": 400 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "stage"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[/\\])\\.\\.(?:[/\\]|$)).+$" },
          "kind": { "type": "string", "minLength": 2, "maxLength": 60 },
          "stage": { "type": "string", "minLength": 2, "maxLength": 30 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "jerusalem_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "solution_id": { "type": "string", "pattern": "^[0-9]{3}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "base_head": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "pull_request_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
    "error": { "type": "string", "maxLength": 400 }
  }
}
